--:
.triword loader_start
10000000:
#include "lib/io.tas"
loader_start:
IO_INIT
ADDI( P07, ZERO, _NOP, 0 );
ADDI( P03, ZERO, _NOP, @(LOADER_START_WORD) );
ADDI( P04, ZERO, _NOP, 10 );
LOADER_START_LOOP:
CALL(IO_READ_TRYTE);
ADDI( P05, P02, _NOP, 0 );
LOADER_START_CHECK:
ADSI( PC, @(LOADER_START_READY - LOADER_START_CHECK - 10), @(LOADER_HALT - LOADER_START_CHECK - 10) );
BRANCH(LOADER_START_LOOP);
LOADER_START_READY:
ST1( P03, P01, _NOP, 0 );
ADDI( P03, P03, _NOP, 1 );
ADDI( P04, P04, _NOP, n );
ADDI( P05, P04, _NOP, 0 );
LOADER_START_COUNT:
ADSI( PC, @(LOADER_START_LOOP - LOADER_START_COUNT - 10), @(LOADER_BASE - LOADER_START_COUNT - 10) );
LOADER_BASE:

ADDI( P03, ZERO, _NOP, @(LOADER_BASE_WORD) );
ADDI( P04, ZERO, _NOP, 10 );
LOADER_BASE_LOOP:
CALL(IO_READ_TRYTE);
ADDI( P05, P02, _NOP, 0 );
LOADER_BASE_CHECK:
ADSI( PC, @(LOADER_BASE_READY - LOADER_BASE_CHECK - 10), @(LOADER_HALT - LOADER_BASE_CHECK - 10) );
BRANCH(LOADER_BASE_LOOP);
LOADER_BASE_READY:
ST1( P03, P01, _NOP, 0 );
ADDI( P03, P03, _NOP, 1 );
ADDI( P04, P04, _NOP, n );
ADDI( P05, P04, _NOP, 0 );
LOADER_BASE_COUNT:
ADSI( PC, @(LOADER_BASE_LOOP - LOADER_BASE_COUNT - 10), @(LOADER_WORD - LOADER_BASE_COUNT - 10) );
LOADER_WORD:
LD3( P07, ZERO, _NOP, @(LOADER_START_WORD) );
LD3( P03, ZERO, _NOP, @(LOADER_BASE_WORD) );
LOADER_LOOP:
CALL(IO_READ_TRYTE);
ADDI( P05, P02, _NOP, 0 );
LOADER_CHECK:
ADSI( PC, @(LOADER_STORE - LOADER_CHECK - 10), @(LOADER_RUN - LOADER_CHECK - 10) );
BRANCH(LOADER_HALT);
LOADER_STORE:
ST1( P03, P01, _NOP, 0 );
ADDI( P03, P03, _NOP, 1 );
BRANCH(LOADER_LOOP);
LOADER_RUN:
ADDI( PC, P07, _NOP, 0 );
LOADER_HALT:
HALT;
LOADER_START_WORD:
.triword 0
LOADER_BASE_WORD:
.triword 0
