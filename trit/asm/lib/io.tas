IO_PUTC:
ST1( ZERO, P01, _NOP, n );
RET;

IO_PUTS:
ADDI( P03, P01, _NOP, 0 );
ADDI( P05, ZERO, _NOP, @(IO_PUTS_PRINT - IO_PUTS_CHECK - 10) );
IO_PUTS_LOOP:
LD1( P01, P03, _NOP, 0 );
IO_PUTS_CHECK:
ADS( PC, P05, _NOP, P05, _NOP );
BRANCH(IO_PUTS_DONE);
IO_PUTS_PRINT:
CALL(IO_PUTC);
ADDI( P03, P03, _NOP, 1 );
BRANCH(IO_PUTS_LOOP);
IO_PUTS_DONE:
ADDI( P01, P03, _NOP, 0 );
RET;

IO_GETC:
ADDI( P05, ZERO, _NOP, @(IO_GETC_READ - IO_GETC_CHECK - 10) );
ADDI( P06, ZERO, _NOP, @(IO_GETC_EOF - IO_GETC_CHECK - 10) );
IO_GETC_WAIT:
LD1( P02, ZERO, _NOP, n001 );
IO_GETC_CHECK:
ADS( PC, P05, _NOP, P06, _NOP );
BRANCH(IO_GETC_WAIT);
IO_GETC_READ:
LD1( P01, ZERO, _NOP, n );
RET;
IO_GETC_EOF:
ADDI( P01, ZERO, _NOP, 0 );
RET;

IO_READ_TRYTE:
ADDI( P08, ZERO, _NOP, 0 );
ADDI( P09, ZERO, _NOP, 100 );
IO_READ_TRYTE_WAIT:
CALL(IO_GETC);
ADDI( P10, P02, _NOP, 0 );
IO_READ_TRYTE_STATUS_CHECK:
ADSI( PC, @(IO_READ_TRYTE_GOT - IO_READ_TRYTE_STATUS_CHECK - 10), @(IO_READ_TRYTE_EOF - IO_READ_TRYTE_STATUS_CHECK - 10) );
IO_READ_TRYTE_GOT:
MULI( P08, P08, _NOP, 10 );
ADD( P08, P08, _NOP, P01, _NOP );
ADDI( P09, P09, _NOP, n );
ADDI( P10, P09, _NOP, 0 );
IO_READ_TRYTE_COUNT_CHECK:
ADSI( PC, @(IO_READ_TRYTE_WAIT - IO_READ_TRYTE_COUNT_CHECK - 10), @(IO_READ_TRYTE_DONE - IO_READ_TRYTE_COUNT_CHECK - 10) );
IO_READ_TRYTE_DONE:
ADDI( P01, P08, _NOP, 0 );
RET;
IO_READ_TRYTE_EOF:
ADDI( P01, ZERO, _NOP, 0 );
RET;

IO_PUT_WORD:
    ADDI( P07, P01, _NOP, 0 );
    ADDI( P08, ZERO, _NOP, 1 );
    ADDI( P11, ZERO, _NOP, 1000 );
IO_PUT_WORD_LOOP:
    TMUL( P09, P07, _NOP, P08, _NOP );
    ADD( P10, P07, _NOP, P09, _NEG );
    ADDI( P07, P10, _NOP, 0 );
    ADDI( P10, ZERO, _NOP, 0 );
    RTLI( P10, P07, _NOP, n );
    ADDI( P06, P09, _NOP, 0 );
IO_PUT_WORD_DIGIT_CHECK:
    ADSI( PC, @(IO_PUT_WORD_ONE - IO_PUT_WORD_DIGIT_CHECK - 10), @(IO_PUT_WORD_NEG - IO_PUT_WORD_DIGIT_CHECK - 10) );
    BRANCH( IO_PUT_WORD_ZERO );
IO_PUT_WORD_NEG:
    ADDI( P01, ZERO, _NOP, 100n1 );
    PSH( SP, P01, _NOP, 10 );
    BRANCH( IO_PUT_WORD_NEXT );
IO_PUT_WORD_ONE:
    ADDI( P01, ZERO, _NOP, 1n00 );
    PSH( SP, P01, _NOP, 10 );
    BRANCH( IO_PUT_WORD_NEXT );
IO_PUT_WORD_ZERO:
    ADDI( P01, ZERO, _NOP, 1n0n );
    PSH( SP, P01, _NOP, 10 );
IO_PUT_WORD_NEXT:
    ADDI( P11, P11, _NOP, n );
IO_PUT_WORD_COUNT_CHECK:
    ADSI( PC, @(IO_PUT_WORD_LOOP - IO_PUT_WORD_COUNT_CHECK - 10), @(IO_PUT_WORD_PRINT - IO_PUT_WORD_COUNT_CHECK - 10) );
    BRANCH( IO_PUT_WORD_PRINT );
IO_PUT_WORD_PRINT:
    ADDI( P11, ZERO, _NOP, 1000 );
IO_PUT_WORD_PRINT_LOOP:
    POP( P01, SP, _NOP, n0 );
    CALL( IO_PUTC );
    ADDI( P11, P11, _NOP, n );
IO_PUT_WORD_PRINT_CHECK:
    ADSI( PC, @(IO_PUT_WORD_PRINT_LOOP - IO_PUT_WORD_PRINT_CHECK - 10), @(IO_PUT_WORD_DONE - IO_PUT_WORD_PRINT_CHECK - 10) );
    BRANCH( IO_PUT_WORD_DONE );
IO_PUT_WORD_DONE:
    RET;

IO_GET_WORD:
    ADDI( P08, ZERO, _NOP, 0 );
    ADDI( P09, ZERO, _NOP, 100n1 );
    ADDI( P10, ZERO, _NOP, 1n0n );
    ADDI( P07, ZERO, _NOP, 1n00 );
    ADDI( P11, ZERO, _NOP, 1000 );
IO_GET_WORD_LOOP:
    CALL( IO_GETC );
    ADDI( P03, P01, _NOP, 0 );
    ADD( P04, P03, _NOP, P09, _NEG );
IO_GET_WORD_N_CHECK:
    ADSI( PC, @(IO_GET_WORD_ZERO_CHECK - IO_GET_WORD_N_CHECK - 10), @(IO_GET_WORD_ZERO_CHECK - IO_GET_WORD_N_CHECK - 10) );
    BRANCH( IO_GET_WORD_DIGIT_N );
IO_GET_WORD_DIGIT_N:
    ADDI( P05, ZERO, _NOP, n );
    BRANCH( IO_GET_WORD_ACCUM );
IO_GET_WORD_ZERO_CHECK:
    ADD( P04, P03, _NOP, P10, _NEG );
IO_GET_WORD_ZERO_TEST:
    ADSI( PC, @(IO_GET_WORD_ONE_CHECK - IO_GET_WORD_ZERO_TEST - 10), @(IO_GET_WORD_ONE_CHECK - IO_GET_WORD_ZERO_TEST - 10) );
    BRANCH( IO_GET_WORD_DIGIT_ZERO );
IO_GET_WORD_DIGIT_ZERO:
    ADDI( P05, ZERO, _NOP, 0 );
    BRANCH( IO_GET_WORD_ACCUM );
IO_GET_WORD_ONE_CHECK:
    ADD( P04, P03, _NOP, P07, _NEG );
IO_GET_WORD_ONE_TEST:
    ADSI( PC, @(IO_GET_WORD_DIGIT_UNKNOWN - IO_GET_WORD_ONE_TEST - 10), @(IO_GET_WORD_DIGIT_UNKNOWN - IO_GET_WORD_ONE_TEST - 10) );
    BRANCH( IO_GET_WORD_DIGIT_ONE );
IO_GET_WORD_DIGIT_UNKNOWN:
    ADDI( P05, ZERO, _NOP, 0 );
    BRANCH( IO_GET_WORD_ACCUM );
IO_GET_WORD_DIGIT_ONE:
    ADDI( P05, ZERO, _NOP, 1 );
IO_GET_WORD_ACCUM:
    MULI( P08, P08, _NOP, 10 );
    ADD( P08, P08, _NOP, P05, _NOP );
    ADDI( P11, P11, _NOP, n );
IO_GET_WORD_COUNT_CHECK:
    ADSI( PC, @(IO_GET_WORD_LOOP - IO_GET_WORD_COUNT_CHECK - 10), @(IO_GET_WORD_DONE - IO_GET_WORD_COUNT_CHECK - 10) );
    BRANCH( IO_GET_WORD_DONE );
IO_GET_WORD_DONE:
    ADDI( P01, P08, _NOP, 0 );
    RET;
