MATH_MOD:
    ADDI( P04, P01, _NOP, 0 );
MATH_MOD_LOOP:
    ADD( P03, P04, _NOP, P02, _NEG );
MATH_MOD_CHECK:
    ADSI( PC, @(MATH_MOD_SUB - MATH_MOD_CHECK - 10), @(MATH_MOD_DONE - MATH_MOD_CHECK - 10) );
    BRANCH( MATH_MOD_ZERO );
MATH_MOD_SUB:
    ADDI( P04, P03, _NOP, 0 );
    BRANCH( MATH_MOD_LOOP );
MATH_MOD_ZERO:
    ADDI( P04, P03, _NOP, 0 );
MATH_MOD_DONE:
    ADDI( P01, P04, _NOP, 0 );
    RET;

MATH_GCD:
MATH_GCD_TEST:
    ADDI( P04, P02, _NOP, 0 );
MATH_GCD_CHECK:
    ADSI( PC, @(MATH_GCD_LOOP - MATH_GCD_CHECK - 10), @(MATH_GCD_DONE - MATH_GCD_CHECK - 10) );
    BRANCH( MATH_GCD_DONE );
MATH_GCD_LOOP:
    CALL( MATH_MOD );
    ADDI( P03, P01, _NOP, 0 );
    ADDI( P01, P02, _NOP, 0 );
    ADDI( P02, P03, _NOP, 0 );
    BRANCH( MATH_GCD_TEST );
MATH_GCD_DONE:
    RET;

MATH_MODPOW:
    ADDI( P06, P02, _NOP, 0 );
    ADDI( P07, P03, _NOP, 0 );
    ADDI( P05, ZERO, _NOP, 1 );
    ADDI( P08, P01, _NOP, 0 );
MATH_MODPOW_TEST:
    ADDI( P04, P06, _NOP, 0 );
MATH_MODPOW_CHECK:
    ADSI( PC, @(MATH_MODPOW_LOOP - MATH_MODPOW_CHECK - 10), @(MATH_MODPOW_DONE - MATH_MODPOW_CHECK - 10) );
    BRANCH( MATH_MODPOW_DONE );
MATH_MODPOW_LOOP:
    MUL( P01, P05, _NOP, P08, _NOP );
    ADDI( P02, P07, _NOP, 0 );
    ADDI( P03, P07, _NOP, 0 );
    CALL( MATH_MOD );
    ADDI( P05, P01, _NOP, 0 );
    ADDI( P06, P06, _NOP, n );
    BRANCH( MATH_MODPOW_TEST );
MATH_MODPOW_DONE:
    ADDI( P01, P05, _NOP, 0 );
    RET;

MATH_ABS:
    ADDI( P01, P01, _ABS, 0 );
    RET;

MATH_NEG:
    ADDI( P01, P01, _NEG, 0 );
    RET;

MATH_SGN:
    ADDI( P03, P01, _NOP, 0 );
MATH_SGN_CHECK:
    ADSI( PC, @(MATH_SGN_POS - MATH_SGN_CHECK - 10), @(MATH_SGN_NEG - MATH_SGN_CHECK - 10) );
    BRANCH( MATH_SGN_ZERO );
MATH_SGN_POS:
    ADDI( P01, ZERO, _NOP, 1 );
    RET;
MATH_SGN_NEG:
    ADDI( P01, ZERO, _NOP, n );
    RET;
MATH_SGN_ZERO:
    ADDI( P01, ZERO, _NOP, 0 );
    RET;

MATH_MIN:
    ADD( P03, P01, _NOP, P02, _NEG );
MATH_MIN_CHECK:
    ADSI( PC, @(MATH_MIN_B - MATH_MIN_CHECK - 10), @(MATH_MIN_A - MATH_MIN_CHECK - 10) );
    BRANCH( MATH_MIN_A );
MATH_MIN_B:
    ADDI( P01, P02, _NOP, 0 );
    RET;
MATH_MIN_A:
    RET;

MATH_MAX:
    ADD( P03, P01, _NOP, P02, _NEG );
MATH_MAX_CHECK:
    ADSI( PC, @(MATH_MAX_A - MATH_MAX_CHECK - 10), @(MATH_MAX_B - MATH_MAX_CHECK - 10) );
    BRANCH( MATH_MAX_A );
MATH_MAX_B:
    ADDI( P01, P02, _NOP, 0 );
    RET;
MATH_MAX_A:
    RET;

MATH_DIV:
    ADDI( P09, P01, _NOP, 0 );
    ADDI( P10, P02, _NOP, 0 );
    ADDI( P11, ZERO, _NOP, 0 );
MATH_DIV_TEST:
    ADDI( P04, P09, _NOP, 0 );
    ADD( P03, P04, _NOP, P10, _NEG );
MATH_DIV_CHECK:
    ADSI( PC, @(MATH_DIV_SUB - MATH_DIV_CHECK - 10), @(MATH_DIV_DONE - MATH_DIV_CHECK - 10) );
    BRANCH( MATH_DIV_ZERO );
MATH_DIV_SUB:
    ADDI( P09, P03, _NOP, 0 );
    ADDI( P11, P11, _NOP, 1 );
    BRANCH( MATH_DIV_TEST );
MATH_DIV_ZERO:
    ADDI( P09, ZERO, _NOP, 0 );
    ADDI( P11, P11, _NOP, 1 );
MATH_DIV_DONE:
    ADDI( P01, P11, _NOP, 0 );
    ADDI( P02, P09, _NOP, 0 );
    RET;
