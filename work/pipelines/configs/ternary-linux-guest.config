# Ternary Linux guest: RV32IMA, no MMU, UP, SBI console.
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
# CONFIG_64BIT is not set
CONFIG_NONPORTABLE=y
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x80400000
# CONFIG_MMU is not set
# CONFIG_RELOCATABLE is not set
# The interpreter handles unaligned accesses itself; avoid the boot-time
# probe that waits for jiffies before the timer is initialized.
# CONFIG_RISCV_PROBE_UNALIGNED_ACCESS is not set
CONFIG_RISCV_EFFICIENT_UNALIGNED_ACCESS=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RISCV_M_MODE is not set
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="console=hvc0 earlycon=sbi"
CONFIG_RISCV_SBI=y
# CONFIG_RISCV_SBI_V01 is not set
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# CONFIG_SMP is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_BINFMT_FLAT=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_ANDES is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_MIPS is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_SIFIVE is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_THEAD is not set
# CONFIG_RISCV_ISA_XTHEADVECTOR is not set
